# Zero Dataset Pipeline — credentials
# Copy to .env and fill in your values.
# NEVER commit .env to git.

# CTFtime session cookie
# Get from: devtools → Application → Cookies → ctftime.org → sessionid
CTFTIME_SESSION=

# HackTheBox App Token
# Get from: app.hackthebox.com → My Profile → Profile Settings → App Tokens → Create App Token
HTB_TOKEN=

# HuggingFace write token (for dataset push)
# Get from: huggingface.co → Settings → Access Tokens → New token (write)
HF_TOKEN=
