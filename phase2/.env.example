# Zero Dataset Pipeline — credentials
# Copy to .env and fill in your values.
# NEVER commit .env to git.

# GitHub Personal Access Token (fine-grained, read-only public repos)
# Get from: github.com → Settings → Developer Settings → Personal Access Tokens → Fine-grained
# Optional — unauthenticated API allows 60 req/hour; with token: 5000 req/hour
GITHUB_TOKEN=

# HackTheBox App Token
# Get from: app.hackthebox.com → My Profile → Profile Settings → App Tokens → Create App Token
HTB_TOKEN=

# HuggingFace write token (for dataset push)
# Get from: huggingface.co → Settings → Access Tokens → New token (write)
HF_TOKEN=
